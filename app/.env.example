# Database: SQLite file by default. For PostgreSQL use postgres://user:pass@host:5432/intranet
DATABASE_URL=file:./data/intranet.db
# Long random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me
AUTH_SECRET=change-me
# Public URL of the intranet, used for the Microsoft redirect URI (APP_URL/auth/callback)
APP_URL=http://localhost:3000

# Comma-separated e-mails that become superadmins on sign-in (everyone else: employee; editors are set in /admin)
SUPERADMIN_EMAILS=

# Dev sign-in (no Microsoft account needed). Must be false in production.
ENABLE_DEV_LOGIN=false

# Microsoft Entra ID app registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
